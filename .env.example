# ==============================================================================
# Cyber Sentinel SOC Dashboard - Environment Variables
# ==============================================================================

# Database storage path (defaults to data/threats.db)
DB_PATH=data/threats.db

# Optional initial seed credentials for role-based accounts (if db is unseeded)
ADMIN_PASSWORD=Admin@12345
ANALYST_PASSWORD=Analyst@12345
VIEWER_PASSWORD=Viewer@12345

# Optional Threat Intelligence API Keys (Leave blank to use built-in offline threat feeds)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_KEY=

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
